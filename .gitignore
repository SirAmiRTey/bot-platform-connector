```gitignore
# Dependencies
vendor/

# Logs
*.log

# Environment
.env
.env.local
*.env.*

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.coverage
coverage/
htmlcov/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# PHP
*.phar

# Compiled and binary files
*.class
*.jar
*.war
*.ear
*.dll
*.so
*.dylib

# Archives
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```